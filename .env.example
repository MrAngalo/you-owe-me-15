# Port the Express server listens on
PORT=3000
# Path to the SQLite file, relative to the project root
DB_FILE=data/app.db
# Public base URL of the app, used to build links in emails
APP_URL=http://localhost:3000
# SMTP server used to send emails (Gmail, port 587 uses STARTTLS)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# Full Gmail address of the sending account
SMTP_USER=your.account@gmail.com
# 16-character Google app password, not the account password
SMTP_PASS=
# Sender shown in the From header, Gmail requires it to match SMTP_USER
MAIL_FROM="You Owe Me 15 <your.account@gmail.com>"

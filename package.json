{
    "name": "you-owe-me-15",
    "version": "1.0.0",
    "description": "",
    "main": "dist/backend/index.js",
    "scripts": {
        "dev:backend": "npm run copy:static && tsx watch src/backend/index.ts",
        "dev:frontend": "cd src/frontend && npx ng build --watch --configuration development",
        "build": "npm run build:backend && npm run build:frontend && npm run copy:static",
        "build:backend": "tsc -p tsconfig.build.json && npm run copy:templates",
        "build:frontend": "cd src/frontend && npx ng build",
        "copy:static": "node -e \"require('fs').cpSync('src/static','dist/static',{recursive:true})\"",
        "copy:templates": "node -e \"require('fs').cpSync('src/backend/templates','dist/backend/templates',{recursive:true})\"",
        "start": "node dist/backend/index.js",
        "lint": "eslint .",
        "typecheck": "tsc --noEmit",
        "db:generate": "drizzle-kit generate",
        "db:migrate": "drizzle-kit migrate",
        "db:studio": "drizzle-kit studio",
        "script:createsuperuser": "tsx src/backend/commands/createsuperuser.ts",
        "test": "npm run test:backend -- --run && npm run test:frontend -- --watch=false",
        "test:backend": "vitest",
        "test:frontend": "cd src/frontend && npx ng test"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/MrAngalo/you-owe-me-15.git"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "type": "commonjs",
    "bugs": {
        "url": "https://github.com/MrAngalo/you-owe-me-15/issues"
    },
    "homepage": "https://github.com/MrAngalo/you-owe-me-15#readme",
    "dependencies": {
        "bcryptjs": "^3.0.3",
        "better-sqlite3": "^13.0.3",
        "drizzle-orm": "^0.45.4",
        "express": "^5.2.1",
        "nodemailer": "^10.3.1",
        "nunjucks": "^3.2.4",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/better-sqlite3": "^9.6.0",
        "@types/express": "^5.0.6",
        "@types/node": "^26.6.4",
        "@types/nodemailer": "^8.0.2",
        "@types/nunjucks": "^3.2.6",
        "drizzle-kit": "^0.31.11",
        "eslint": "^10.12.0",
        "eslint-config-prettier": "^10.1.8",
        "prettier": "^3.9.9",
        "tsx": "^4.23.15",
        "typescript": "~6.0",
        "typescript-eslint": "^8.71.1",
        "vitest": "^5.1.0"
    }
}

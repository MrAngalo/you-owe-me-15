{
    "name": "you-owe-me-15",
    "version": "1.0.0",
    "description": "",
    "main": "dist/backend/index.js",
    "scripts": {
        "dev:backend": "npm run copy:static && tsx watch src/backend/index.ts",
        "dev:frontend": "cd src/frontend && npx ng build --watch --configuration development",
        "build": "npm run build:backend && npm run build:frontend && npm run copy:static",
        "build:backend": "tsc",
        "build:frontend": "cd src/frontend && npx ng build",
        "copy:static": "node -e \"require('fs').cpSync('src/static','dist/static',{recursive:true})\"",
        "start": "node dist/backend/index.js",
        "lint": "eslint .",
        "typecheck": "tsc --noEmit",
        "test:frontend": "cd src/frontend && npx ng test"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/MrAngalo/you-owe-me-15.git"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "type": "commonjs",
    "bugs": {
        "url": "https://github.com/MrAngalo/you-owe-me-15/issues"
    },
    "homepage": "https://github.com/MrAngalo/you-owe-me-15#readme",
    "dependencies": {
        "express": "^5.2.1"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/express": "^5.0.6",
        "@types/node": "^26.6.4",
        "eslint": "^10.12.0",
        "eslint-config-prettier": "^10.1.8",
        "prettier": "^3.9.9",
        "tsx": "^4.23.15",
        "typescript": "~6.0",
        "typescript-eslint": "^8.71.1"
    }
}
